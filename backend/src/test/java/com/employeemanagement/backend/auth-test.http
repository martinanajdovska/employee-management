@baseUrl = http://localhost:8080/api/auth
@username = fdds
@password = password123
@email = fdds@example.com
@firstName = first
@lastName= last

POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{username}}",
  "firstName": "{{firstName}}",
  "lastName": "{{lastName}}",
  "password": "{{password}}",
  "email": "{{email}}"
}

###

POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
POST {{baseUrl}}/logout