@baseUrl = http://localhost:8080/api/auth
@username = fd
@password = password123
@email = fd@example.com

POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}",
  "email": "{{email}}"
}

###

POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
POST {{baseUrl}}/logout